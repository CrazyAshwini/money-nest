# Copy to .env.local. Never commit real credentials or financial documents.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy public anon key is supported as a fallback only.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
APP_URL=http://localhost:3000
# Exact canonical origin, including the local port. VERCEL_URL is supplied by Vercel
# and permits only the current deployment's exact origin, including preview APIs.
# Email callback destinations must also be in Supabase Auth's redirect allowlist.
APP_TIMEZONE=Asia/Kolkata
APP_CURRENCY=INR
# Server-only connection for migrations; never prefix this with NEXT_PUBLIC_.
DATABASE_URL=
# Optional notification worker; no external notification is sent without opt-in.
CRON_SECRET=
# Optional private profile on this computer; server-only, never NEXT_PUBLIC_.
FINANCE_PRIVATE_ENABLED=false
# App-owner receipt AI credentials. Server-only; never prefix with NEXT_PUBLIC_.
# Users do not provide keys. The selected provider never falls back to another.
RECEIPT_AI_PROVIDER=gemini
# Get an owner key from https://aistudio.google.com/apikey.
# Use a Google project on Free Tier; billing-enabled projects can incur charges.
# Free-tier uploads must exclude personal, sensitive and confidential information.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional; blank uses gemini-3.5-flash-lite.
GOOGLE_GENERATIVE_AI_MODEL=
# Alternative: explicitly set RECEIPT_AI_PROVIDER=gateway for Vercel AI Gateway.
AI_GATEWAY_API_KEY=
# Optional Gateway model; blank uses openai/gpt-5.4-nano.
AI_GATEWAY_MODEL=
