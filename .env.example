# Copy to .env.local. Never commit real credentials or financial documents.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy public anon key is supported as a fallback only.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Kolkata
APP_CURRENCY=INR
# Server-only connection for migrations; never prefix this with NEXT_PUBLIC_.
DATABASE_URL=
# Optional notification worker; no external notification is sent without opt-in.
CRON_SECRET=
# Optional private profile on this computer; server-only, never NEXT_PUBLIC_.
FINANCE_PRIVATE_ENABLED=false
# App-owner receipt AI credentials. Server-only; never prefix with NEXT_PUBLIC_.
# Users upload receipts without providing an API key. Scans use the owner's credits.
AI_GATEWAY_API_KEY=
# Optional receipt model; leave blank to use the app's default.
AI_GATEWAY_MODEL=
