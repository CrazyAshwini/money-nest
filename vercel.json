{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci --include=optional --no-audit --no-fund",
  "git": {
    "deploymentEnabled": {
      "feat/signup-email-otp": false,
      "feat/responsive-account-carousels": false,
      "feat/public-multi-user-workspaces": false,
      "feat/interactive-analytics-cards": false,
      "feat/compact-credit-card-summaries": false,
      "feat/final-ui-refinement": false
    }
  },
  "regions": ["icn1"]
}
